# Public Supabase values used by the Next.js browser/server client.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only values. Do not prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
XINVOICE_CLIENT_ID=your-xinvoice-client-id
XINVOICE_API_KEY=your-xinvoice-api-key
REFRESH_WORKER_SECRET=replace-with-a-long-random-secret
