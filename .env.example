# TAX ID Checker - environment template
#
# Copy this file to .env.local for local Next.js development:
#   Copy-Item .env.example .env.local
#
# Never commit .env, .env.local, real API keys, database passwords or taxpayer data.

# ============================================================================
# 1) VERCEL / NEXT.JS (server-side values)
# ============================================================================
# The browser talks only to Next.js API routes. Never expose SUPABASE_SECRET_KEY.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_with_your_key

# Simple internal application login (store these in Vercel Environment Variables).
APP_LOGIN_USERNAME=hainh
APP_LOGIN_PASSWORD=replace_with_internal_password
APP_SESSION_SECRET=replace_with_a_long_random_session_secret

# Vercel AI Gateway (server-side only; never expose this key to the browser).
# Official variable name: AI_GATEWAY_API_KEY
AI_GATEWAY_API_KEY=replace_with_vercel_ai_gateway_api_key

# Invoice import limit: 4 MiB = 4,194,304 bytes.
INVOICE_MAX_UPLOAD_BYTES=4194304
INVOICE_MONTHLY_SCAN_LIMIT=200

# Taxpayer Excel import limits: 10 MiB and 10,000 data rows by default.
MST_IMPORT_MAX_UPLOAD_BYTES=10485760
MST_IMPORT_MAX_ROWS=10000

# Not required by the current server-only architecture. Keep only for a future
# direct/public Supabase client:
# NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_your_key

# ============================================================================
# 2) SUPABASE CLI / LOCAL MIGRATION AND SEED (local or CI only)
# ============================================================================
# Used by `supabase link` and `supabase db push`.
# Do not add these to NEXT_PUBLIC_* variables or expose them in the browser.
SUPABASE_ACCESS_TOKEN=sbp_replace_with_personal_access_token
SUPABASE_DB_PASSWORD=replace_with_project_database_password
SUPABASE_PROJECT_ID=replace_with_project_reference_id

# ============================================================================
# 3) SUPABASE EDGE FUNCTION INTERNAL VALUES
# ============================================================================
# Hosted Edge Functions automatically provide these Supabase values:
#   SUPABASE_URL
#   SUPABASE_PUBLISHABLE_KEYS
#   SUPABASE_SECRET_KEYS
# Do not copy a secret key into the frontend. SUPABASE_SECRET_KEYS is a JSON
# dictionary supplied by Supabase; the function reads its `default` entry.
# For local `supabase functions serve`, provide a local equivalent only when
# needed, for example:
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SECRET_KEYS={"default":"sb_secret_replace_with_your_key"}

# ============================================================================
# 4) WORKER SECRET (Supabase Edge Function secret)
# ============================================================================
# The public XInvoice tax-payer endpoint does not require client credentials.
# Set the same internal worker secret in Supabase Edge Function secrets and in
# the Vercel server environment so the per-row Update button can invoke it:
#   supabase secrets set REFRESH_WORKER_SECRET=...
REFRESH_WORKER_SECRET=replace_with_a_long_random_secret

# ============================================================================
# LEGACY COMPATIBILITY (do not use for new deployments)
# ============================================================================
# Supabase is deprecating these key names by the end of 2026. The application
# still accepts them as a temporary fallback during migration.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=legacy_anon_key
# SUPABASE_SERVICE_ROLE_KEY=legacy_service_role_key
APP_READONLY_USERNAME=
APP_READONLY_PASSWORD=
